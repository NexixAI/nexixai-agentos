# =============================================================================
# AgentOS Environment Variables Reference
# =============================================================================
# Copy this file to .env and adjust values for your deployment.
# All variables are optional unless marked [REQUIRED].

# -----------------------------------------------------------------------------
# Model Provider Configuration
# -----------------------------------------------------------------------------
# [REQUIRED] Model provider backend: "openai", "anthropic", or "stub"
AGENTOS_MODEL_PROVIDER=openai

# [REQUIRED for openai] Base URL of the model API (e.g., vLLM, OpenAI)
AGENTOS_MODEL_BASE_URL=http://localhost:8000/v1

# [REQUIRED for openai/anthropic] API key for the model provider
AGENTOS_MODEL_API_KEY=

# Alternative: read API key from a file (takes precedence over AGENTOS_MODEL_API_KEY)
# AGENTOS_MODEL_API_KEY_FILE=/run/secrets/model_api_key

# Default model name when requests don't specify one
AGENTOS_MODEL_DEFAULT=nvidia/Llama-3.3-70B-Instruct-FP8

# Model API request timeout (Go duration format)
AGENTOS_MODEL_TIMEOUT=60s

# -----------------------------------------------------------------------------
# Storage Backend
# -----------------------------------------------------------------------------
# Storage backend: "file" (default) or "postgres"
# File backend is for development only — use Postgres in production.
AGENTOS_STORAGE_BACKEND=file

# --- Postgres settings (required when AGENTOS_STORAGE_BACKEND=postgres) ---
AGENTOS_DB_HOST=localhost
AGENTOS_DB_PORT=5432
AGENTOS_DB_NAME=agentos
AGENTOS_DB_USER=agentos
AGENTOS_DB_PASSWORD=
# AGENTOS_DB_PASSWORD_FILE=/run/secrets/db_password
AGENTOS_DB_SSLMODE=require
AGENTOS_DB_POOL_SIZE=10

# --- File backend overrides ---
# AGENTOS_RUN_STORE_FILE=data/agent-orchestrator/runs.json
# AGENTOS_AGENT_STORE_DIR=data/agents
# AGENTOS_MEMORY_STORE_DIR=data/memory
# AGENTOS_KV_STORE_DIR=data/kv

# -----------------------------------------------------------------------------
# Execution Engine
# -----------------------------------------------------------------------------
# Number of concurrent executor worker goroutines
AGENTOS_EXEC_WORKERS=5

# Default max steps per agent run (prevents infinite loops)
AGENTOS_EXEC_DEFAULT_MAX_STEPS=10

# Default wall-clock timeout per run (Go duration format)
AGENTOS_EXEC_DEFAULT_TIMEOUT=300s

# Max bytes per tool result before truncation (default 1MB)
AGENTOS_EXEC_TOOL_MAX_OUTPUT=1048576

# -----------------------------------------------------------------------------
# Quota & Rate Limiting
# -----------------------------------------------------------------------------
# Max requests per second for run creation (per tenant)
AGENTOS_QUOTA_RUN_CREATE_QPS=10

# Max concurrent runs per tenant
AGENTOS_QUOTA_CONCURRENT_RUNS=25

# Hourly token budget per tenant (0 = unlimited)
AGENTOS_QUOTA_HOURLY_TOKENS=0

# -----------------------------------------------------------------------------
# Memory Store
# -----------------------------------------------------------------------------
# Max conversation messages retained per agent
AGENTOS_MEMORY_MAX_MESSAGES=50

# Max total tokens in conversation memory per agent
AGENTOS_MEMORY_MAX_TOKENS=8192

# -----------------------------------------------------------------------------
# KV Store
# -----------------------------------------------------------------------------
# Max value size in bytes for KV store entries
AGENTOS_KV_MAX_VALUE_SIZE=65536

# Max keys per agent in KV store
AGENTOS_KV_MAX_KEYS_PER_AGENT=1000

# -----------------------------------------------------------------------------
# PII Detection
# -----------------------------------------------------------------------------
# Enable PII scanning on inputs/outputs
AGENTOS_PII_ENABLED=true

# PII handling mode: "warn" (log), "block" (reject), "redact" (mask)
AGENTOS_PII_DEFAULT_MODE=warn

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Default tenant ID (auto-created on startup for dev environments)
AGENTOS_DEFAULT_TENANT=tnt_demo

# JWT signing secret for inter-service auth
# AGENTOS_JWT_SECRET=

# Require auth for /metrics endpoint (set to "1" in production)
AGENTOS_METRICS_REQUIRE_AUTH=0

# -----------------------------------------------------------------------------
# OIDC / OAuth (optional, Track 12)
# -----------------------------------------------------------------------------
# OIDC issuer URL (enables OIDC token validation)
# AGENTOS_OIDC_ISSUER_URL=https://auth.example.com

# OIDC audience expected in JWT tokens
# AGENTOS_OIDC_AUDIENCE=agentos

# JWT claim containing the tenant ID (default: "tenant_id")
# AGENTOS_OIDC_TENANT_CLAIM=tenant_id

# -----------------------------------------------------------------------------
# Federation
# -----------------------------------------------------------------------------
# Path to peers registry JSON file
# AGENTOS_PEERS_FILE=deploy/peers.json

# Local stack identity overrides
# AGENTOS_STACK_ID=stack-001
# AGENTOS_ENVIRONMENT=production
# AGENTOS_REGION=us-east-1

# Federation health check interval (Go duration format)
AGENTOS_FED_HEALTH_INTERVAL=30s

# TLS for federation (mTLS between stacks)
# AGENTOS_FED_SERVER_CERT=/path/to/cert.pem
# AGENTOS_FED_SERVER_KEY=/path/to/key.pem
# AGENTOS_FED_CA_CERT=/path/to/ca.pem

# -----------------------------------------------------------------------------
# Portainer (container status observation)
# -----------------------------------------------------------------------------
# Portainer API base URL (default: https://localhost:9443/api)
PORTAINER_API_URL=https://192.168.50.57:9443/api

# [REQUIRED for get_container_status tool] Portainer API token.
# Generate in Portainer: Settings → Users → <user> → API tokens → Add access token
PORTAINER_API_KEY=

# -----------------------------------------------------------------------------
# Tool Sandbox
# -----------------------------------------------------------------------------
# Base directory for file_read/file_write tools (path restriction)
AGENTOS_TOOL_FILE_BASE_DIR=/tmp/agentos-sandbox

# -----------------------------------------------------------------------------
# Logging & Observability
# -----------------------------------------------------------------------------
# Log format: "" (text, default) or "json"
AGENTOS_LOG_FORMAT=

# Application profile: "" (dev, default) or "prod"
# AGENTOS_PROFILE=

# Max HTTP request body size in bytes
AGENTOS_MAX_BODY_SIZE=1048576

# Graceful shutdown timeout (Go duration format)
AGENTOS_SHUTDOWN_TIMEOUT=30s
